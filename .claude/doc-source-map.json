{
  "_comment": "Maps documentation files to the source files they describe. Used by drift-detector to flag contradictions when source changes.",
  "_updated": "2026-03-14",

  "README.md": ["packages/*/lib/**/*.dart"],
  "CLAUDE.md": [".claude/**/*"],
  "CONTRIBUTING.md": ["melos.yaml", "analysis_options.yaml"],

  "packages/nexus_store/README.md": ["packages/nexus_store/lib/**/*.dart"],
  "packages/nexus_store_drift_adapter/README.md": ["packages/nexus_store_drift_adapter/lib/**/*.dart"],
  "packages/nexus_store_powersync_adapter/README.md": ["packages/nexus_store_powersync_adapter/lib/**/*.dart"],
  "packages/nexus_store_supabase_adapter/README.md": ["packages/nexus_store_supabase_adapter/lib/**/*.dart"],
  "packages/nexus_store_brick_adapter/README.md": ["packages/nexus_store_brick_adapter/lib/**/*.dart"],
  "packages/nexus_store_crdt_adapter/README.md": ["packages/nexus_store_crdt_adapter/lib/**/*.dart"],
  "packages/nexus_store_bloc_binding/README.md": ["packages/nexus_store_bloc_binding/lib/**/*.dart"],
  "packages/nexus_store_riverpod_binding/README.md": ["packages/nexus_store_riverpod_binding/lib/**/*.dart"],
  "packages/nexus_store_signals_binding/README.md": ["packages/nexus_store_signals_binding/lib/**/*.dart"],
  "packages/nexus_store_flutter_widgets/README.md": ["packages/nexus_store_flutter_widgets/lib/**/*.dart"],
  "packages/nexus_store_generator/README.md": ["packages/nexus_store_generator/lib/**/*.dart"],
  "packages/nexus_store_entity_generator/README.md": ["packages/nexus_store_entity_generator/lib/**/*.dart"],
  "packages/nexus_store_riverpod_generator/README.md": ["packages/nexus_store_riverpod_generator/lib/**/*.dart"],

  ".claude/rules/architecture.md": [".claude/invariants/layer-deps.dart", ".claude/invariants/public-api-surface.dart"],
  ".claude/rules/testing.md": [".claude/hooks/core/smart-test-run.py"],
  ".claude/rules/git-commits.md": [".claude/hooks/core/strip-commit-attribution.py"],
  ".claude/rules/data-layer.md": ["packages/nexus_store/lib/src/**/*.dart"],
  ".claude/rules/code-generation.md": ["packages/nexus_store_generator/lib/**/*.dart", "packages/nexus_store_entity_generator/lib/**/*.dart"],

  ".claude/agents/agent-index.json": [".claude/agents/*.md"],
  ".claude/invariants/README.md": [".claude/invariants/*.dart"],
  ".claude/settings.json": [".claude/hooks/core/*.py"],

  "AGENTS.md": [".claude/agents/*.md", ".claude/invariants/*.dart"]
}
